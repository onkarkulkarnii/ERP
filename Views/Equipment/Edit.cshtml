@model ERP.Models.Equipment
@{ ViewBag.Title = "Edit Equipment"; ViewBag.PageTitle = "Edit Equipment"; }

<div class="page-header">
    <div>
        <h5><i class="fa-solid fa-pen text-orange me-2"></i>Edit Equipment</h5>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Equipment</a></li>
            <li class="breadcrumb-item active">@Model.EquipmentCode</li>
        </ol></nav>
    </div>
</div>

@using (Html.BeginForm("Edit","Equipment",FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m=>m.EquipmentId)
    @Html.HiddenFor(m=>m.EquipmentCode)
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="card">
                <div class="card-header">Equipment — <span class="text-orange">@Model.EquipmentCode</span></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Equipment Name *</label>
                            @Html.TextBoxFor(m=>m.EquipmentName, new{@class="form-control"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Category</label>
                            @Html.DropDownListFor(m=>m.Category, new SelectList(ViewBag.Categories as string[], Model.Category), "-- Select --", new{@class="form-select"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Manufacturer</label>
                            @Html.TextBoxFor(m=>m.Manufacturer, new{@class="form-control"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Model</label>
                            @Html.TextBoxFor(m=>m.Model, new{@class="form-control"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Registration No.</label>
                            @Html.TextBoxFor(m=>m.RegistrationNumber, new{@class="form-control"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Purchase Date</label>
                            @Html.TextBoxFor(m=>m.PurchaseDate, "{0:yyyy-MM-dd}", new{@class="form-control",type="date"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Purchase Value (₹)</label>
                            @Html.TextBoxFor(m=>m.PurchaseValue, new{@class="form-control",type="number",step="1000"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Rental Cost/Day (₹)</label>
                            @Html.TextBoxFor(m=>m.RentalCostPerDay, new{@class="form-control",type="number",step="100"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            @Html.DropDownListFor(m=>m.Status, new SelectList(ViewBag.Statuses as string[], Model.Status), new{@class="form-select"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last Maintenance</label>
                            @Html.TextBoxFor(m=>m.LastMaintenanceDate, "{0:yyyy-MM-dd}", new{@class="form-control",type="date"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Next Maintenance Due</label>
                            @Html.TextBoxFor(m=>m.NextMaintenanceDue, "{0:yyyy-MM-dd}", new{@class="form-control",type="date"})
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Current Project</label>
                            @Html.DropDownListFor(m=>m.CurrentProjectId, ViewBag.Projects as List<System.Web.Mvc.SelectListItem>, new{@class="form-select"})
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check ms-2">
                                @Html.CheckBoxFor(m=>m.IsOwned, new{@class="form-check-input"})
                                <label class="form-check-label form-label">Owned</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Remarks</label>
                            @Html.TextAreaFor(m=>m.Remarks, new{@class="form-control",rows=2})
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card">
                <div class="card-header">Actions</div>
                <div class="card-body">
                    <button type="submit" class="btn btn-arcus w-100 mb-2"><i class="fa-solid fa-floppy-disk me-1"></i>Update</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100">Cancel</a>
                </div>
            </div>
        </div>
    </div>
}
