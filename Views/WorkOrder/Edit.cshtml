@model ERP.Models.WorkOrder
@{ ViewBag.Title = "Edit Work Order"; ViewBag.PageTitle = "Edit Work Order"; }

<div class="page-header">
    <div>
        <h5><i class="fa-solid fa-pen text-orange me-2"></i>Edit Work Order</h5>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Work Orders</a></li>
            <li class="breadcrumb-item active">@Model.WorkOrderCode</li>
        </ol></nav>
    </div>
</div>

@using (Html.BeginForm("Edit","WorkOrder",FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m=>m.WorkOrderId)
    @Html.HiddenFor(m=>m.WorkOrderCode)
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="card">
                <div class="card-header">Work Order — <span class="text-orange">@Model.WorkOrderCode</span></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Title *</label>
                            @Html.TextBoxFor(m=>m.Title, new{@class="form-control"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Project</label>
                            @Html.DropDownListFor(m=>m.ProjectId, ViewBag.Projects as List<System.Web.Mvc.SelectListItem>, new{@class="form-select"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contractor</label>
                            @Html.DropDownListFor(m=>m.ContractorId, ViewBag.Contractors as List<System.Web.Mvc.SelectListItem>, new{@class="form-select"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Work Type</label>
                            @Html.DropDownListFor(m=>m.WorkType, new SelectList(ViewBag.WorkTypes as string[], Model.WorkType), "-- Select --", new{@class="form-select"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Priority</label>
                            @Html.DropDownListFor(m=>m.Priority, new SelectList(ViewBag.Priorities as string[], Model.Priority), new{@class="form-select"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            @Html.DropDownListFor(m=>m.Status, new SelectList(ViewBag.Statuses as string[], Model.Status), new{@class="form-select"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Start Date</label>
                            @Html.TextBoxFor(m=>m.StartDate, "{0:yyyy-MM-dd}", new{@class="form-control",type="date"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">End Date</label>
                            @Html.TextBoxFor(m=>m.EndDate, "{0:yyyy-MM-dd}", new{@class="form-control",type="date"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Contract Amount (₹)</label>
                            @Html.TextBoxFor(m=>m.ContractAmount, new{@class="form-control",type="number",step="1000"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Paid Amount (₹)</label>
                            @Html.TextBoxFor(m=>m.PaidAmount, new{@class="form-control",type="number",step="1000"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Assigned To</label>
                            @Html.TextBoxFor(m=>m.AssignedTo, new{@class="form-control"})
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            @Html.TextAreaFor(m=>m.Description, new{@class="form-control",rows=3})
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card">
                <div class="card-header">Actions</div>
                <div class="card-body">
                    <button type="submit" class="btn btn-arcus w-100 mb-2"><i class="fa-solid fa-floppy-disk me-1"></i>Update</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100">Cancel</a>
                </div>
            </div>
            <div class="card mt-3">
                <div class="card-header">Summary</div>
                <div class="card-body fs-xs">
                    <div class="mb-2"><span class="text-muted">Contract:</span> <strong>&#8377;@Model.ContractAmount.ToString("N0")</strong></div>
                    <div class="mb-2"><span class="text-muted">Paid:</span> <strong class="text-success">&#8377;@Model.PaidAmount.ToString("N0")</strong></div>
                    <div><span class="text-muted">Balance:</span> <strong class="text-danger">&#8377;@Model.BalanceAmount.ToString("N0")</strong></div>
                </div>
            </div>
        </div>
    </div>
}
