@model ERP.Models.WorkOrder
@{ ViewBag.Title = "New Work Order"; ViewBag.PageTitle = "Create Work Order"; }

<div class="page-header">
    <div>
        <h5><i class="fa-solid fa-plus text-orange me-2"></i>New Work Order</h5>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Work Orders</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol></nav>
    </div>
</div>

@using (Html.BeginForm("Create","WorkOrder",FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="card">
                <div class="card-header">Work Order Details</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Work Order Code *</label>
                            @Html.TextBoxFor(m=>m.WorkOrderCode, new{@class="form-control",placeholder="WO-2026-001"})
                            @Html.ValidationMessageFor(m=>m.WorkOrderCode,"",new{@class="text-danger fs-xs"})
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Title *</label>
                            @Html.TextBoxFor(m=>m.Title, new{@class="form-control"})
                            @Html.ValidationMessageFor(m=>m.Title,"",new{@class="text-danger fs-xs"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Project *</label>
                            @Html.DropDownListFor(m=>m.ProjectId, ViewBag.Projects as List<System.Web.Mvc.SelectListItem>, "-- Select Project --", new{@class="form-select"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contractor</label>
                            @Html.DropDownListFor(m=>m.ContractorId, ViewBag.Contractors as List<System.Web.Mvc.SelectListItem>, new{@class="form-select"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Work Type</label>
                            @Html.DropDownListFor(m=>m.WorkType, new SelectList(ViewBag.WorkTypes as string[]), "-- Select --", new{@class="form-select"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Priority</label>
                            @Html.DropDownListFor(m=>m.Priority, new SelectList(ViewBag.Priorities as string[]), new{@class="form-select"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            @Html.DropDownListFor(m=>m.Status, new SelectList(ViewBag.Statuses as string[]), new{@class="form-select"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Start Date</label>
                            @Html.TextBoxFor(m=>m.StartDate, "{0:yyyy-MM-dd}", new{@class="form-control",type="date"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">End Date</label>
                            @Html.TextBoxFor(m=>m.EndDate, "{0:yyyy-MM-dd}", new{@class="form-control",type="date"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contract Amount (₹)</label>
                            @Html.TextBoxFor(m=>m.ContractAmount, new{@class="form-control",type="number",step="1000"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Assigned To</label>
                            @Html.TextBoxFor(m=>m.AssignedTo, new{@class="form-control"})
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            @Html.TextAreaFor(m=>m.Description, new{@class="form-control",rows=3})
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card">
                <div class="card-header">Actions</div>
                <div class="card-body">
                    <button type="submit" class="btn btn-arcus w-100 mb-2"><i class="fa-solid fa-floppy-disk me-1"></i>Create Work Order</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100">Cancel</a>
                </div>
            </div>
        </div>
    </div>
}
