@model ERP.Models.Material
@{ ViewBag.Title = "Add Material"; ViewBag.PageTitle = "Add Material"; }

<div class="page-header">
    <div>
        <h5><i class="fa-solid fa-plus text-orange me-2"></i>Add Material</h5>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Materials</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol></nav>
    </div>
</div>

@using (Html.BeginForm("Create","Material",FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="card">
                <div class="card-header">Material Details</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Material Code *</label>
                            @Html.TextBoxFor(m=>m.MaterialCode, new{@class="form-control",placeholder="MAT-CEM-003"})
                            @Html.ValidationMessageFor(m=>m.MaterialCode,"",new{@class="text-danger fs-xs"})
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Material Name *</label>
                            @Html.TextBoxFor(m=>m.MaterialName, new{@class="form-control"})
                            @Html.ValidationMessageFor(m=>m.MaterialName,"",new{@class="text-danger fs-xs"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Category</label>
                            @Html.DropDownListFor(m=>m.Category, new SelectList(ViewBag.Categories as List<string>), "-- Select --", new{@class="form-select"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Unit</label>
                            @Html.DropDownListFor(m=>m.Unit, new SelectList(ViewBag.Units as List<string>), "-- Select --", new{@class="form-select"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Unit Price (₹)</label>
                            @Html.TextBoxFor(m=>m.UnitPrice, new{@class="form-control",type="number",step="0.01"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Current Stock</label>
                            @Html.TextBoxFor(m=>m.CurrentStock, new{@class="form-control",type="number",step="0.01"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Min. Stock Level</label>
                            @Html.TextBoxFor(m=>m.MinStockLevel, new{@class="form-control",type="number",step="0.01"})
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">GST Rate (%)</label>
                            @Html.TextBoxFor(m=>m.GSTRate, new{@class="form-control",type="number",step="0.5"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Supplier</label>
                            @Html.TextBoxFor(m=>m.Supplier, new{@class="form-control"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">HSN Code</label>
                            @Html.TextBoxFor(m=>m.HSNCode, new{@class="form-control"})
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            @Html.TextAreaFor(m=>m.Description, new{@class="form-control",rows=2})
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card">
                <div class="card-header">Actions</div>
                <div class="card-body">
                    <button type="submit" class="btn btn-arcus w-100 mb-2"><i class="fa-solid fa-floppy-disk me-1"></i>Save Material</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100">Cancel</a>
                </div>
            </div>
        </div>
    </div>
}
