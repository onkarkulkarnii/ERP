@model ERP.Models.Project
@{ ViewBag.Title = "Edit Project"; ViewBag.PageTitle = "Edit Project"; }

<div class="page-header">
    <div>
        <h5><i class="fa-solid fa-pen text-orange me-2"></i>Edit Project</h5>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Projects</a></li>
            <li class="breadcrumb-item active">@Model.ProjectCode</li>
        </ol></nav>
    </div>
</div>

@using (Html.BeginForm("Edit","Project",FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m=>m.ProjectId)
    @Html.HiddenFor(m=>m.ProjectCode)
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="card">
                <div class="card-header">Project Information &mdash; <span class="text-orange">@Model.ProjectCode</span></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Project Name *</label>
                            @Html.TextBoxFor(m=>m.ProjectName, new{@class="form-control"})
                            @Html.ValidationMessageFor(m=>m.ProjectName,"",new{@class="text-danger fs-xs"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Client Name</label>
                            @Html.TextBoxFor(m=>m.ClientName, new{@class="form-control"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Project Type</label>
                            @Html.DropDownListFor(m=>m.ProjectType, new SelectList(ViewBag.ProjectTypes as string[], Model.ProjectType), "-- Select --", new{@class="form-select"})
                        </div>
                        <div class="col-12">
                            <label class="form-label">Location</label>
                            @Html.TextBoxFor(m=>m.Location, new{@class="form-control"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Start Date</label>
                            @Html.TextBoxFor(m=>m.StartDate, "{0:yyyy-MM-dd}", new{@class="form-control",type="date"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">End Date</label>
                            @Html.TextBoxFor(m=>m.EndDate, "{0:yyyy-MM-dd}", new{@class="form-control",type="date"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Budget (₹)</label>
                            @Html.TextBoxFor(m=>m.Budget, new{@class="form-control",type="number",step="1000"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contract Value (₹)</label>
                            @Html.TextBoxFor(m=>m.ContractValue, new{@class="form-control",type="number",step="1000"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Project Manager</label>
                            @Html.TextBoxFor(m=>m.ProjectManager, new{@class="form-control"})
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            @Html.DropDownListFor(m=>m.Status, new SelectList(ViewBag.Statuses as string[], Model.Status), new{@class="form-select"})
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Progress (%)</label>
                            @Html.TextBoxFor(m=>m.ProgressPercent, new{@class="form-control",type="number",min=0,max=100})
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            @Html.TextAreaFor(m=>m.Description, new{@class="form-control",rows=3})
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card">
                <div class="card-header">Actions</div>
                <div class="card-body">
                    <button type="submit" class="btn btn-arcus w-100 mb-2"><i class="fa-solid fa-floppy-disk me-1"></i>Update Project</button>
                    <a href="@Url.Action("Details",new{id=Model.ProjectId})" class="btn btn-outline-secondary w-100 mb-2">View Details</a>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100">Back to List</a>
                </div>
            </div>
            <div class="card mt-3">
                <div class="card-header">Info</div>
                <div class="card-body">
                    <div class="fs-xs text-muted mb-1">Created: @Model.CreatedDate.ToString("dd MMM yyyy")</div>
                    <div class="progress mt-2 mb-1"><div class="progress-bar" style="width:@Model.ProgressPercent%"></div></div>
                    <div class="fs-xs text-muted">@Model.ProgressPercent% complete</div>
                </div>
            </div>
        </div>
    </div>
}
