<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Arcus Infra Construction ERP</title>
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="~/Content/arcus.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>

<!-- ════════════════════════════════════════════════
     SIDEBAR
════════════════════════════════════════════════ -->
<aside class="arcus-sidebar">
    <div class="arcus-brand">
        <div class="arcus-brand-icon"><i class="fa-solid fa-building-columns"></i></div>
        <div class="arcus-brand-text">
            <strong>Arcus Infra</strong>
            <small>Construction ERP</small>
        </div>
    </div>

    <nav class="sidebar-nav">
        <div class="sidebar-section-label">Main</div>
        <a href="@Url.Action("Index","Dashboard")"
           class="nav-link @(ViewContext.RouteData.Values["controller"].ToString()=="Dashboard"?"active":"")">
            <i class="fa-solid fa-gauge-high"></i> Dashboard
        </a>

        <div class="sidebar-section-label">Project Management</div>
        <a href="@Url.Action("Index","Project")"
           class="nav-link @(ViewContext.RouteData.Values["controller"].ToString()=="Project"?"active":"")">
            <i class="fa-solid fa-diagram-project"></i> Projects
        </a>
        <a href="@Url.Action("Index","WorkOrder")"
           class="nav-link @(ViewContext.RouteData.Values["controller"].ToString()=="WorkOrder"?"active":"")">
            <i class="fa-solid fa-clipboard-list"></i> Work Orders
        </a>

        <div class="sidebar-section-label">People</div>
        <a href="@Url.Action("Index","Employee")"
           class="nav-link @(ViewContext.RouteData.Values["controller"].ToString()=="Employee"?"active":"")">
            <i class="fa-solid fa-users"></i> Employees
        </a>
        <a href="@Url.Action("Index","Contractor")"
           class="nav-link @(ViewContext.RouteData.Values["controller"].ToString()=="Contractor"?"active":"")">
            <i class="fa-solid fa-handshake"></i> Contractors
        </a>

        <div class="sidebar-section-label">Resources</div>
        <a href="@Url.Action("Index","Material")"
           class="nav-link @(ViewContext.RouteData.Values["controller"].ToString()=="Material"?"active":"")">
            <i class="fa-solid fa-boxes-stacked"></i> Materials
        </a>
        <a href="@Url.Action("Index","Equipment")"
           class="nav-link @(ViewContext.RouteData.Values["controller"].ToString()=="Equipment"?"active":"")">
            <i class="fa-solid fa-truck-monster"></i> Equipment
        </a>

        <div class="sidebar-section-label">Finance</div>
        <a href="@Url.Action("Index","Finance")"
           class="nav-link @(ViewContext.RouteData.Values["controller"].ToString()=="Finance" && ViewContext.RouteData.Values["action"].ToString()=="Index"?"active":"")">
            <i class="fa-solid fa-chart-line"></i> Finance Overview
        </a>
        <a href="@Url.Action("Invoices","Finance")"
           class="nav-link @(ViewContext.RouteData.Values["controller"].ToString()=="Finance" && ViewContext.RouteData.Values["action"].ToString()=="Invoices"?"active":"")">
            <i class="fa-solid fa-file-invoice-dollar"></i> Invoices
        </a>
        <a href="@Url.Action("Expenses","Finance")"
           class="nav-link @(ViewContext.RouteData.Values["controller"].ToString()=="Finance" && ViewContext.RouteData.Values["action"].ToString()=="Expenses"?"active":"")">
            <i class="fa-solid fa-receipt"></i> Expenses
        </a>

        <div class="sidebar-section-label">EHS</div>
        <a href="@Url.Action("Index","Safety")"
           class="nav-link @(ViewContext.RouteData.Values["controller"].ToString()=="Safety"?"active":"")">
            <i class="fa-solid fa-helmet-safety"></i> Safety &amp; Incidents
        </a>
    </nav>

    <div class="sidebar-footer">
        &copy; @DateTime.Now.Year Arcus Infra Construction
    </div>
</aside>

<!-- ════════════════════════════════════════════════
     MAIN CONTENT
════════════════════════════════════════════════ -->
<div class="arcus-main">
    <header class="arcus-topbar">
        <h6 class="page-title mb-0">@(ViewBag.PageTitle ?? ViewBag.Title ?? "ERP")</h6>
        <div class="topbar-right">
            <span class="fs-xs text-muted"><i class="fa-regular fa-calendar me-1"></i>@DateTime.Now.ToString("dd MMM yyyy")</span>
            <div class="topbar-user">
                <div class="topbar-avatar">AI</div>
                <span>Admin</span>
            </div>
        </div>
    </header>

    <main class="arcus-page">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show py-2 px-3 mb-3" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show py-2 px-3 mb-3" role="alert">
                <i class="fa-solid fa-circle-xmark me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="arcus-footer">
        Arcus Infra Construction ERP &mdash; Powered by ASP.NET MVC &nbsp;|&nbsp; Version 1.0
    </footer>
</div>

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")
@RenderSection("scripts", required: false)
</body>
</html>
