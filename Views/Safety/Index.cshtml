@model IEnumerable<ERP.Models.SafetyIncident>
@{ ViewBag.Title = "Safety & Incidents"; ViewBag.PageTitle = "Safety & Incident Register"; }

<div class="page-header">
    <div>
        <h5><i class="fa-solid fa-helmet-safety text-orange me-2"></i>Safety & Incident Register</h5>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-arcus"><i class="fa-solid fa-plus me-1"></i>Report Incident</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon red"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div class="stat-info">
                <div class="stat-value">@ViewBag.TotalOpen</div>
                <div class="stat-label">Open Incidents</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon yellow"><i class="fa-solid fa-person-falling-burst"></i></div>
            <div class="stat-info">
                <div class="stat-value">@ViewBag.TotalLTI</div>
                <div class="stat-label">Lost Time Injuries (LTI)</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="fa-solid fa-eye"></i></div>
            <div class="stat-info">
                <div class="stat-value">@ViewBag.TotalNearMiss</div>
                <div class="stat-label">Near Miss Incidents</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search…" />
            </div>
            <div class="col-md-3">
                <select name="type" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    @foreach (var t in new[]{"NearMiss","FirstAid","LostTime","Fatality","PropertyDamage","FireAlarm","EnvironmentalSpill"})
                    {
                        <option value="@t" @(ViewBag.Type==t?"selected":"")>@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Status</option>
                    <option value="Open" @(ViewBag.Status=="Open"?"selected":"")>Open</option>
                    <option value="UnderInvestigation" @(ViewBag.Status=="UnderInvestigation"?"selected":"")>Under Investigation</option>
                    <option value="Closed" @(ViewBag.Status=="Closed"?"selected":"")>Closed</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-arcus"><i class="fa-solid fa-magnifying-glass me-1"></i>Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary ms-1">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr><th>Code</th><th>Date</th><th>Type</th><th>Project</th><th>Description</th><th>Injured Person</th><th>Location</th><th>Reported By</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">No incidents recorded.</td></tr>
                    }
                    @foreach (var inc in Model)
                    {
                        <tr>
                            <td><span class="fw-700 text-orange">@inc.IncidentCode</span></td>
                            <td class="fs-xs">@inc.IncidentDate.ToString("dd MMM yy") @(inc.IncidentTime != null ? "@ "+inc.IncidentTime : "")</td>
                            <td>
                                @{
                                    var typeClass = inc.IncidentType switch {
                                        "Fatality"      => "bg-danger text-white",
                                        "LostTime"      => "bg-warning text-dark",
                                        "FirstAid"      => "bg-info text-dark",
                                        "NearMiss"      => "bg-primary text-white",
                                        "PropertyDamage"=> "bg-secondary text-white",
                                        _               => "bg-light text-dark border"
                                    };
                                }
                                <span class="badge @typeClass" style="font-size:0.68rem">@inc.IncidentType</span>
                            </td>
                            <td class="fs-xs text-muted">@inc.ProjectName</td>
                            <td class="fs-xs" style="max-width:200px">@(inc.Description?.Length > 70 ? inc.Description.Substring(0,70)+"…" : inc.Description)</td>
                            <td class="fs-xs">@inc.InjuredPerson</td>
                            <td class="fs-xs text-muted">@inc.Location</td>
                            <td class="fs-xs text-muted">@inc.ReportedBy</td>
                            <td>
                                <span class="badge badge-@inc.Status?.ToLower().Replace(" ","")">
                                    @inc.Status
                                </span>
                            </td>
                            <td>
                                <a href="@Url.Action("Edit",new{id=inc.IncidentId})" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
