@model IEnumerable<ERP.Models.Contractor>
@{ ViewBag.Title = "Contractors"; ViewBag.PageTitle = "Contractors"; }

<div class="page-header">
    <div>
        <h5><i class="fa-solid fa-handshake text-orange me-2"></i>Contractors</h5>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item active">All Contractors</li></ol></nav>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-arcus"><i class="fa-solid fa-plus me-1"></i>Add Contractor</a>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search company, contact…" />
            </div>
            <div class="col-md-3">
                <select name="specialty" class="form-select form-select-sm">
                    <option value="">All Specialties</option>
                    @foreach (var s in ViewBag.Specialties as List<string>)
                    {
                        <option value="@s" @(ViewBag.Specialty==s?"selected":"")>@s</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-arcus"><i class="fa-solid fa-magnifying-glass me-1"></i>Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary ms-1">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr><th>Code</th><th>Company</th><th>Contact</th><th>Specialty</th><th>Phone</th><th>License Expiry</th><th>Rating</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">No contractors found.</td></tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><span class="fw-700 text-orange">@c.ContractorCode</span></td>
                            <td>
                                <div class="fw-700">@c.CompanyName</div>
                                <div class="fs-xs text-muted">@c.EmailAddress</div>
                            </td>
                            <td class="fs-xs">@c.ContactPerson</td>
                            <td><span class="badge bg-light text-dark border">@c.SpecialtyType</span></td>
                            <td class="fs-xs">@c.PhoneNumber</td>
                            <td class="fs-xs @(c.LicenseExpiry.HasValue && c.LicenseExpiry.Value < DateTime.Today ? "text-danger fw-700" : "")">
                                @(c.LicenseExpiry.HasValue ? c.LicenseExpiry.Value.ToString("dd MMM yy") : "--")
                            </td>
                            <td>
                                @for (int i=1;i<=5;i++)
                                {
                                    <i class="fa-@(i<=c.Rating?"solid":"regular") fa-star text-warning" style="font-size:0.75rem"></i>
                                }
                            </td>
                            <td><span class="badge badge-@c.Status?.ToLower()">@c.Status</span></td>
                            <td class="text-nowrap">
                                <a href="@Url.Action("Edit",new{id=c.ContractorId})" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <form method="post" action="@Url.Action("Delete",new{id=c.ContractorId})" style="display:inline" onsubmit="return confirm('Deactivate this contractor?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger ms-1" title="Deactivate"><i class="fa-solid fa-ban"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
