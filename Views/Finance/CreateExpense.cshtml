@model ERP.Models.Expense
@{ ViewBag.Title = "Record Expense"; ViewBag.PageTitle = "Record Expense"; }

<div class="page-header">
    <div>
        <h5><i class="fa-solid fa-plus text-orange me-2"></i>Record Expense</h5>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Expenses")">Expenses</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol></nav>
    </div>
</div>

@using (Html.BeginForm("CreateExpense","Finance",FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-xl-7">
            <div class="card">
                <div class="card-header">Expense Details</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Expense Date *</label>
                            @Html.TextBoxFor(m=>m.ExpenseDate, "{0:yyyy-MM-dd}", new{@class="form-control",type="date"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Voucher No.</label>
                            @Html.TextBoxFor(m=>m.VoucherNumber, new{@class="form-control",placeholder="EXP-2026-011"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Project</label>
                            @Html.DropDownListFor(m=>m.ProjectId, ViewBag.Projects as List<System.Web.Mvc.SelectListItem>, new{@class="form-select"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Category *</label>
                            @Html.DropDownListFor(m=>m.Category, new SelectList(ViewBag.Categories as string[]), "-- Select --", new{@class="form-select"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Amount (₹) *</label>
                            @Html.TextBoxFor(m=>m.Amount, new{@class="form-control",type="number",step="0.01"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Payment Mode</label>
                            @Html.DropDownListFor(m=>m.PaymentMode, new SelectList(ViewBag.PaymentModes as string[]), "-- Select --", new{@class="form-select"})
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Approved By</label>
                            @Html.TextBoxFor(m=>m.ApprovedBy, new{@class="form-control"})
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            @Html.TextAreaFor(m=>m.Description, new{@class="form-control",rows=3})
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-5">
            <div class="card">
                <div class="card-header">Actions</div>
                <div class="card-body">
                    <button type="submit" class="btn btn-arcus w-100 mb-2"><i class="fa-solid fa-floppy-disk me-1"></i>Save Expense</button>
                    <a href="@Url.Action("Expenses")" class="btn btn-outline-secondary w-100">Cancel</a>
                </div>
            </div>
        </div>
    </div>
}
